<!DOCTYPE html>
<html lang="ca">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>FireTrack Parc - Inventari Mòbil</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://jsdelivr.net"></script>
    <!-- FontAwesome per a icones -->
    <link rel="stylesheet" href="https://cloudflare.com">
    <style>
        body {
            -webkit-tap-highlight-color: transparent;
        }
        .hide-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .hide-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
        /* Estils específics per a impressió */
        @media print {
            body {
                background-color: white !important;
                color: black !important;
            }
            .no-print {
                display: none !important;
            }
            #print-area {
                display: block !important;
                position: static !important;
                width: 100% !important;
                color: black !important;
            }
            table {
                width: 100%;
                border-collapse: collapse;
                font-size: 12px;
            }
            th, td {
                border: 1px solid #cbd5e1;
                padding: 6px 8px;
                text-align: left;
            }
            th {
                background-color: #f1f5f9 !important;
                -webkit-print-color-adjust: exact;
            }
        }
    </style>
</head>
<body class="bg-slate-900 text-slate-100 font-sans antialiased min-h-screen flex flex-col justify-between selection:bg-red-600 selection:text-white">

    <!-- CAPÇALERA -->
    <header class="no-print bg-slate-950 border-b border-slate-800 sticky top-0 z-40 px-4 py-3 flex items-center justify-between shadow-md">
        <div class="flex items-center space-x-3">
            <div class="bg-red-600 text-white p-2 rounded-xl shadow-lg shadow-red-600/30 flex items-center justify-center">
                <i class="fa-solid fa-truck-fire text-lg"></i>
            </div>
            <div>
                <h1 class="font-bold text-base tracking-wide text-white leading-tight">FireTrack <span class="text-red-500">Parc</span></h1>
                <p class="text-xs text-slate-400">Parc de Bombers · Inventari Mòbil</p>
            </div>
        </div>
        <div class="flex items-center space-x-2">
            <button onclick="obrirModalGestio()" class="bg-slate-800 hover:bg-slate-700 active:bg-slate-600 text-slate-300 p-2.5 rounded-xl text-xs font-medium transition flex items-center space-x-1.5 border border-slate-700">
                <i class="fa-solid fa-gear text-slate-400"></i>
                <span class="hidden sm:inline">Gestió</span>
            </button>
            <button onclick="nouMaterialModal()" class="bg-red-600 hover:bg-red-500 active:bg-red-700 text-white px-3 py-2.5 rounded-xl text-xs font-semibold shadow-lg shadow-red-600/20 transition flex items-center space-x-1.5">
                <i class="fa-solid fa-plus"></i>
                <span>Nou</span>
            </button>
        </div>
    </header>

    <!-- CONTINGUT PRINCIPAL -->
    <main id="main-content" class="no-print flex-1 max-w-lg w-full mx-auto px-4 py-4 pb-24">
        <!-- Es carregarà dinàmicament segons la pestanya activa -->
    </main>

    <!-- ZONA D'IMPRESSIÓ (Oculta en pantalla, visible en imprimir) -->
    <div id="print-area" class="hidden p-6"></div>

    <!-- BARRA DE NAVEGACIÓ INFERIOR -->
    <nav class="no-print bg-slate-950 border-t border-slate-800 fixed bottom-0 left-0 right-0 z-40 max-w-lg mx-auto grid grid-cols-4 py-2 px-3 shadow-2xl">
        <button onclick="canviarPestanya('flota')" id="nav-flota" class="nav-btn flex flex-col items-center justify-center py-1.5 text-red-500 transition">
            <i class="fa-solid fa-truck text-lg mb-0.5"></i>
            <span class="text-[10px] font-medium tracking-wide">Flota</span>
        </button>
        <button onclick="canviarPestanya('magatzem')" id="nav-magatzem" class="nav-btn flex flex-col items-center justify-center py-1.5 text-slate-400 hover:text-slate-200 transition">
            <i class="fa-solid fa-warehouse text-lg mb-0.5"></i>
            <span class="text-[10px] font-medium tracking-wide">Magatzem</span>
        </button>
        <button onclick="canviarPestanya('desplaçaments')" id="nav-desplaçaments" class="nav-btn flex flex-col items-center justify-center py-1.5 text-slate-400 hover:text-slate-200 transition">
            <i class="fa-solid fa-route text-lg mb-0.5"></i>
            <span class="text-[10px] font-medium tracking-wide">Desplaçaments</span>
        </button>
        <button onclick="canviarPestanya('historial')" id="nav-historial" class="nav-btn flex flex-col items-center justify-center py-1.5 text-slate-400 hover:text-slate-200 transition">
            <i class="fa-solid fa-clock-rotate-left text-lg mb-0.5"></i>
            <span class="text-[10px] font-medium tracking-wide">Historial</span>
        </button>
    </nav>

    <!-- MODAL DE MOVIMENT DE MATERIAL -->
    <div id="modal-moure" class="no-print fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm hidden flex items-end sm:items-center justify-center p-0 sm:p-4">
        <div class="bg-slate-900 border border-slate-800 w-full max-w-md rounded-t-3xl sm:rounded-2xl p-5 shadow-2xl max-h-[90vh] overflow-y-auto">
            <div class="flex items-center justify-between pb-3 border-b border-slate-800 mb-4">
                <div class="flex items-center space-x-2">
                    <div class="bg-red-500/10 text-red-500 p-2 rounded-lg">
                        <i class="fa-solid fa-right-left"></i>
                    </div>
                    <h3 class="font-bold text-white text-sm">Moure Material</h3>
                </div>
                <button onclick="tancarModal('modal-moure')" class="text-slate-400 hover:text-white p-1">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>
            <form id="form-moure" onsubmit="guardarMoviment(event)" class="space-y-4">
                <input type="hidden" id="moure-material-id">
                <div>
                    <label class="block text-xs font-medium text-slate-400 mb-1">Material Seleccionat</label>
                    <p id="moure-material-nom" class="text-sm font-bold text-white bg-slate-950 px-3 py-2 rounded-xl border border-slate-800"></p>
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-400 mb-1">Nova Ubicació Destí</label>
                    <select id="moure-desti-tipus" onchange="actualitzarDestiTipus()" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2.5 text-sm text-white focus:outline-none focus:border-red-500">
                        <option value="vehicle">Vehicle (Camió)</option>
                        <option value="magatzem">Magatzem Central</option>
                        <option value="taller">Taller / Reparació</option>
                        <option value="baixa">Baixa / Fora de servei</option>
                    </select>
                </div>
                <div id="bloc-seleccio-vehicle" class="space-y-3">
                    <div>
                        <label class="block text-xs font-medium text-slate-400 mb-1">Seleccionar Camió</label>
                        <select id="moure-vehicle-id" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2.5 text-sm text-white focus:outline-none focus:border-red-500"></select>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-slate-400 mb-1">Compartiment / Zona Destí</label>
                        <select id="moure-compartiment" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2.5 text-sm text-white focus:outline-none focus:border-red-500">
                            <option value="Cabina">Cabina</option>
                            <option value="Armari 1">Armari 1</option>
                            <option value="Armari 3">Armari 3</option>
                            <option value="Armari 5">Armari 5</option>
                            <option value="Armari 2">Armari 2</option>
                            <option value="Armari 4">Armari 4</option>
                            <option value="Armari 6">Armari 6</option>
                            <option value="Bomba">Bomba</option>
                            <option value="Sostre">Sostre</option>
                        </select>
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-400 mb-1">Observacions del moviment (opcional)</label>
                    <input type="text" id="moure-notes" placeholder="Ex: Canvi temporal per revisió" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2.5 text-sm text-white focus:outline-none focus:border-red-500">
                </div>
                <button type="submit" class="w-full bg-red-600 hover:bg-red-500 text-white font-semibold py-3 rounded-xl text-sm shadow-lg shadow-red-600/20 transition">
                    Confirmar Moviment
                </button>
            </form>
        </div>
    </div>

    <!-- MODAL NOU / EDITAR MATERIAL -->
    <div id="modal-material" class="no-print fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm hidden flex items-end sm:items-center justify-center p-0 sm:p-4">
        <div class="bg-slate-900 border border-slate-800 w-full max-w-md rounded-t-3xl sm:rounded-2xl p-5 shadow-2xl max-h-[90vh] overflow-y-auto">
